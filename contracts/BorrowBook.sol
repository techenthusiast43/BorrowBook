pragma solidity ^0.8.20;

/**
 * @title BorrowBook
 * @dev Decentralized lending and borrowing record tracking dApp on BOT Chain.
 */
contract BorrowBook {
    enum LoanStatus {
        None,             // 0: Does not exist
        AwaitingBorrower, // 1: Created by lender, awaiting borrower receipt confirmation
        Borrowed,         // 2: Confirmed by borrower as received
        ReturnPending,    // 3: Lender marked the item as returned
        Returned,         // 4: Borrower confirmed the item has been returned (terminal)
        Cancelled         // 5: Cancelled by lender prior to borrowing (terminal)
    }

    struct Loan {
        address lender;
        address borrower;
        uint64 createdAt;
        uint64 expectedReturnDate;
        uint64 returnedAt;
        LoanStatus status;
        string itemName;
        string description;
    }

    // Mapping from unique loanId to Loan struct
    mapping(bytes32 => Loan) private _loans;

    // Track all loan IDs for public discovery and activity feed
    bytes32[] private _allLoanIds;

    // Track loan IDs by lender and borrower
    mapping(address => bytes32[]) private _lenderLoans;
    mapping(address => bytes32[]) private _borrowerLoans;

    // Custom errors for gas efficiency
    error InvalidLoanId();
    error DuplicateLoanId();
    error LoanDoesNotExist();
    error InvalidBorrowerAddress();
    error SelfLendingNotAllowed();
    error EmptyItemName();
    error InvalidExpectedReturnDate();
    error Unauthorized();
    error InvalidStateTransition(LoanStatus currentStatus, LoanStatus requiredStatus);

    // Events
    event LoanCreated(
        bytes32 indexed loanId,
        address indexed lender,
        address indexed borrower,
        string itemName,
        string description,
        uint256 expectedReturnDate,
        uint256 createdAt
    );

    event BorrowingConfirmed(
        bytes32 indexed loanId,
        address indexed borrower,
        uint256 timestamp
    );

    event ReturnInitiated(
        bytes32 indexed loanId,
        address indexed lender,
        uint256 timestamp
    );

    event ReturnConfirmed(
        bytes32 indexed loanId,
        address indexed borrower,
        uint256 timestamp
    );

    event LoanCancelled(
        bytes32 indexed loanId,
        address indexed lender,
        uint256 timestamp
    );

    /**
     * @notice Creates a new loan record.
     * @param loanId Unique identifier for the loan (generated by client).
     * @param borrower The address of the borrower.
     * @param itemName Name of the lent item.
     * @param description Brief description of item condition/terms.
     * @param expectedReturnDate Unix timestamp representing expected return deadline.
     */
    function createLoan(
        bytes32 loanId,
        address borrower,
        string calldata itemName,
        string calldata description,
        uint256 expectedReturnDate
    ) external {
        if (loanId == bytes32(0)) revert InvalidLoanId();
        if (_loans[loanId].status != LoanStatus.None) revert DuplicateLoanId();
        if (borrower == address(0)) revert InvalidBorrowerAddress();
        if (borrower == msg.sender) revert SelfLendingNotAllowed();
        if (bytes(itemName).length == 0) revert EmptyItemName();
        if (expectedReturnDate <= block.timestamp) revert InvalidExpectedReturnDate();

        _loans[loanId] = Loan({
            lender: msg.sender,
            borrower: borrower,
            createdAt: uint64(block.timestamp),
            expectedReturnDate: uint64(expectedReturnDate),
            returnedAt: 0,
            status: LoanStatus.AwaitingBorrower,
            itemName: itemName,
            description: description
        });

        _allLoanIds.push(loanId);
        _lenderLoans[msg.sender].push(loanId);
        _borrowerLoans[borrower].push(loanId);

        emit LoanCreated(
            loanId,
            msg.sender,
            borrower,
            itemName,
            description,
            expectedReturnDate,
            block.timestamp
        );
    }

    /**
     * @notice Allows the designated borrower to confirm receipt of the item.
     * @param loanId The unique identifier of the loan.
     */
    function confirmBorrowing(bytes32 loanId) external {
        Loan storage loan = _loans[loanId];
        if (loan.status == LoanStatus.None) revert LoanDoesNotExist();
        if (msg.sender != loan.borrower) revert Unauthorized();
        if (loan.status != LoanStatus.AwaitingBorrower) {
            revert InvalidStateTransition(loan.status, LoanStatus.AwaitingBorrower);
        }

        loan.status = LoanStatus.Borrowed;
        emit BorrowingConfirmed(loanId, msg.sender, block.timestamp);
    }

    /**
     * @notice Allows the lender to mark that the item has been returned.
     * @param loanId The unique identifier of the loan.
     */
    function markReturned(bytes32 loanId) external {
        Loan storage loan = _loans[loanId];
        if (loan.status == LoanStatus.None) revert LoanDoesNotExist();
        if (msg.sender != loan.lender) revert Unauthorized();
        if (loan.status != LoanStatus.Borrowed) {
            revert InvalidStateTransition(loan.status, LoanStatus.Borrowed);
        }

        loan.status = LoanStatus.ReturnPending;
        emit ReturnInitiated(loanId, msg.sender, block.timestamp);
    }

    /**
     * @notice Allows the borrower to confirm that the return process is completed.
     * @param loanId The unique identifier of the loan.
     */
    function confirmReturn(bytes32 loanId) external {
        Loan storage loan = _loans[loanId];
        if (loan.status == LoanStatus.None) revert LoanDoesNotExist();
        if (msg.sender != loan.borrower) revert Unauthorized();
        if (loan.status != LoanStatus.ReturnPending) {
            revert InvalidStateTransition(loan.status, LoanStatus.ReturnPending);
        }

        loan.status = LoanStatus.Returned;
        loan.returnedAt = uint64(block.timestamp);
        emit ReturnConfirmed(loanId, msg.sender, block.timestamp);
    }

    /**
     * @notice Allows the lender to cancel a loan before the borrower confirms receipt.
     * @param loanId The unique identifier of the loan.
     */
    function cancelLoan(bytes32 loanId) external {
        Loan storage loan = _loans[loanId];
        if (loan.status == LoanStatus.None) revert LoanDoesNotExist();
        if (msg.sender != loan.lender) revert Unauthorized();
        if (loan.status != LoanStatus.AwaitingBorrower) {
            revert InvalidStateTransition(loan.status, LoanStatus.AwaitingBorrower);
        }

        loan.status = LoanStatus.Cancelled;
        emit LoanCancelled(loanId, msg.sender, block.timestamp);
    }

    /**
     * @notice Retrieves full loan details.
     * @param loanId The unique identifier of the loan.
     */
    function getLoan(bytes32 loanId)
        external
        view
        returns (
            address lender,
            address borrower,
            uint64 createdAt,
            uint64 expectedReturnDate,
            uint64 returnedAt,
            LoanStatus status,
            string memory itemName,
            string memory description
        )
    {
        Loan storage loan = _loans[loanId];
        if (loan.status == LoanStatus.None) revert LoanDoesNotExist();

        return (
            loan.lender,
            loan.borrower,
            loan.createdAt,
            loan.expectedReturnDate,
            loan.returnedAt,
            loan.status,
            loan.itemName,
            loan.description
        );
    }

    /**
     * @notice Returns total number of loans created.
     */
    function getTotalLoansCount() external view returns (uint256) {
        return _allLoanIds.length;
    }

    /**
     * @notice Returns all loan IDs.
     */
    function getAllLoanIds() external view returns (bytes32[] memory) {
        return _allLoanIds;
    }

    /**
     * @notice Returns loan IDs created by a specific lender.
     */
    function getLenderLoans(address lender) external view returns (bytes32[] memory) {
        return _lenderLoans[lender];
    }

    /**
     * @notice Returns loan IDs where a specific address is the borrower.
     */
    function getBorrowerLoans(address borrower) external view returns (bytes32[] memory) {
        return _borrowerLoans[borrower];
    }
}

